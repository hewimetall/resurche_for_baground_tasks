# Отдельный образ: arq 0.28 требует redis<6 и не ставится рядом с taskiq-redis.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app
COPY requirements-arq.txt /tmp/requirements-arq.txt
RUN pip install --no-cache-dir -r /tmp/requirements-arq.txt
